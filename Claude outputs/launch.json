{
    // Press F5 (or Run > Start Debugging) with this configuration selected:
    // it starts the AirWatch server in the background (tasks.json), waits
    // until it logs "AirWatch running at ...", then opens it in Chrome.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Run AirWatch (starts server + opens Chrome)",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/public",
            "preLaunchTask": "Start AirWatch server"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
